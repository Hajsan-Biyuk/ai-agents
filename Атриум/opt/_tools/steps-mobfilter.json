[{"eval":"(()=>{const b=[...document.querySelectorAll('*')].filter(e=>/Открыть фильтры/i.test(e.textContent)&&e.children.length<3).slice(-3);return b.map(e=>e.tagName+'.'+e.className+' #'+e.id+' vis='+(e.offsetParent!==null)+' rect='+JSON.stringify(e.getBoundingClientRect()))})()","label":"buttons"},
{"eval":"(()=>{const f=document.querySelector('.bx_filter, #smartfilter, .filter_wrapper, .visible_mobile_filter');return f?f.className+' disp='+getComputedStyle(f).display+' '+getComputedStyle(f.closest('[class*=filter]')||f).display:'nofilter'})()","label":"filter"},
{"eval":"(()=>{const e=[...document.querySelectorAll('.bx-filter-title, .filter_opener, [class*=filter-btn], [class*=filter_opener], .js-filter-show')];return e.map(x=>x.className+'|'+x.textContent.trim().slice(0,30))})()","label":"openers"}]
